# Which files the template owns, for scripts/update-llm-wiki.sh. Tab separated; the first matching line wins.
#   never    the notebook owns it: the updater never touches it
#   managed  template-owned: updated when you have not changed it, three-way merged when both sides changed
#   merge    like managed, but expect customizations (AGENTS.md); conflicts are handed to the assistant
#   once     copied only when missing, never overwritten
#   mirror   a real copy of the source (third column), regenerated by scripts/sync_agent_files.py; replaces symlinks, which Windows checkouts break
# Patterns use shell globs; * also matches slashes.
never	raw/*
never	wiki/*
never	README.md
never	LICENSE
never	github-pages/*
never	docs/images/*
never	tests/test_github_pages.py
never	tests/test_readme.py
never	scripts/new-llm-wiki.sh
never	scripts/new-llm-wiki.ps1
never	scripts/install-macos.command
never	scripts/install-linux.sh
never	scripts/bootstrap.sh
never	scripts/bootstrap.ps1
never	scripts/install-windows.ps1
never	scripts/install-windows.cmd
merge	AGENTS.md
once	.github/workflows/test.yml
managed	.agents/skills/*
managed	.agents/commands/*
managed	.agents/template-manifest
managed	scripts/*
managed	tests/*
managed	docs/migration.md
mirror	CLAUDE.md	AGENTS.md
mirror	.cursorrules	AGENTS.md
mirror	.github/copilot-instructions.md	AGENTS.md
mirror	.claude/skills	.agents/skills
mirror	.claude/commands	.agents/commands
mirror	.opencode/skills	.agents/skills
mirror	.opencode/commands	.agents/commands
